// Fikra database schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects      Project[]
  levelProgress LevelProgress[]
  levelAttempts LevelAttempt[]
  hintUsages    HintUsage[]

  fileVersions ProjectFileVersion[]
  builds       ProjectBuild[]
  exports      ProjectExport[]

  joinRequests        ProjectJoinRequest[]
  projectMemberships  ProjectMember[]
  levelAssignments    LevelAssignment[]
  contributions       Contribution[]
  contributionReviews ContributionReview[]

  @@map("users")
}

model Project {
  id          String        @id @default(uuid())
  ownerId     String
  title       String
  description String
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner          User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  analyses       ProjectAnalysis[]
  clarifications ClarificationQuestion[]
  suggestions    ProjectSuggestion[]
  technologies   ProjectTechnology[]
  roadmaps       Roadmap[]

  files   ProjectFile[]
  builds  ProjectBuild[]
  exports ProjectExport[]

  joinRequests  ProjectJoinRequest[]
  members       ProjectMember[]
  assignments   LevelAssignment[]
  contributions Contribution[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectAnalysis {
  id        String @id @default(uuid())
  projectId String

  summary           String
  problemStatement  String?
  targetUsers       String?
  coreFeatures      Json
  functionalReqs    Json?
  nonFunctionalReqs Json?
  assumptions       Json?
  aiModel           String?
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_analyses")
}

model ClarificationQuestion {
  id        String @id @default(uuid())
  projectId String

  question      String
  questionOrder Int
  isRequired    Boolean  @default(true)
  createdAt     DateTime @default(now())

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  answer  ClarificationAnswer?

  @@unique([projectId, questionOrder])
  @@index([projectId])
  @@map("clarification_questions")
}

model ClarificationAnswer {
  id         String @id @default(uuid())
  questionId String @unique

  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question ClarificationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("clarification_answers")
}

model ProjectSuggestion {
  id        String @id @default(uuid())
  projectId String

  title       String
  description String
  reason      String?
  status      SuggestionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_suggestions")
}

model Technology {
  id          String             @id @default(uuid())
  name        String             @unique
  category    TechnologyCategory
  description String?
  iconUrl     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  projects ProjectTechnology[]

  @@map("technologies")
}

model ProjectTechnology {
  id           String @id @default(uuid())
  projectId    String
  technologyId String

  recommendedByAi Boolean  @default(false)
  selected        Boolean  @default(false)
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([projectId, technologyId])
  @@index([projectId])
  @@index([technologyId])
  @@map("project_technologies")
}

model Roadmap {
  id        String @id @default(uuid())
  projectId String

  title       String
  description String?
  version     Int     @default(1)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stages  RoadmapStage[]

  @@unique([projectId, version])
  @@index([projectId])
  @@map("roadmaps")
}

model RoadmapStage {
  id        String @id @default(uuid())
  roadmapId String

  title       String
  description String?
  stageOrder  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roadmap Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  levels  CodingLevel[]

  @@unique([roadmapId, stageOrder])
  @@index([roadmapId])
  @@map("roadmap_stages")
}

model CodingLevel {
  id      String @id @default(uuid())
  stageId String

  title        String
  description  String
  instructions String
  levelOrder   Int
  difficulty   LevelDifficulty @default(BEGINNER)
  xpReward     Int             @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stage RoadmapStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  dependencies     CodingLevelDependency[] @relation("DependentLevel")
  requiredByLevels CodingLevelDependency[] @relation("RequiredLevel")

  progress     LevelProgress[]
  attempts     LevelAttempt[]
  hints        Hint[]
  fileVersions ProjectFileVersion[]
  assignments  LevelAssignment[]

  @@unique([stageId, levelOrder])
  @@index([stageId])
  @@map("coding_levels")
}

model CodingLevelDependency {
  id String @id @default(uuid())

  levelId         String
  requiredLevelId String

  createdAt DateTime @default(now())

  level         CodingLevel @relation("DependentLevel", fields: [levelId], references: [id], onDelete: Cascade)
  requiredLevel CodingLevel @relation("RequiredLevel", fields: [requiredLevelId], references: [id], onDelete: Cascade)

  @@unique([levelId, requiredLevelId])
  @@index([levelId])
  @@index([requiredLevelId])
  @@map("coding_level_dependencies")
}

model LevelProgress {
  id      String @id @default(uuid())
  userId  String
  levelId String

  status      LevelProgressStatus @default(LOCKED)
  xpEarned    Int                 @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  level CodingLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
  @@index([levelId])
  @@map("level_progress")
}

model LevelAttempt {
  id      String @id @default(uuid())
  userId  String
  levelId String

  attemptNumber Int
  submittedCode String?
  result        LevelAttemptResult @default(PENDING)
  feedback      String?
  score         Int?
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  level CodingLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId, attemptNumber])
  @@index([userId])
  @@index([levelId])
  @@map("level_attempts")
}

model Hint {
  id      String @id @default(uuid())
  levelId String

  content   String
  hintOrder Int
  xpCost    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  level  CodingLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  usages HintUsage[]

  @@unique([levelId, hintOrder])
  @@index([levelId])
  @@map("hints")
}

model HintUsage {
  id     String @id @default(uuid())
  userId String
  hintId String

  usedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  hint Hint @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@unique([userId, hintId])
  @@index([userId])
  @@index([hintId])
  @@map("hint_usages")
}

model ProjectFile {
  id        String @id @default(uuid())
  projectId String

  path      String
  fileName  String
  language  String?
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions ProjectFileVersion[]

  @@unique([projectId, path])
  @@index([projectId])
  @@map("project_files")
}

model ProjectFileVersion {
  id             String  @id @default(uuid())
  fileId         String
  userId         String?
  levelId        String?
  contributionId String?

  versionNumber Int
  content       String
  changeType    FileChangeType
  changeSummary String?
  generatedByAi Boolean        @default(false)

  createdAt DateTime @default(now())

  file         ProjectFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  level        CodingLevel?  @relation(fields: [levelId], references: [id], onDelete: SetNull)
  contribution Contribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)

  @@unique([fileId, versionNumber])
  @@index([fileId])
  @@index([userId])
  @@index([levelId])
  @@index([contributionId])
  @@map("project_file_versions")
}

model ProjectBuild {
  id        String  @id @default(uuid())
  projectId String
  userId    String?

  status       BuildStatus @default(PENDING)
  buildNumber  Int
  logs         String?
  artifactPath String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([projectId, buildNumber])
  @@index([projectId])
  @@index([userId])
  @@map("project_builds")
}

model ProjectExport {
  id        String  @id @default(uuid())
  projectId String
  userId    String?

  format      ExportFormat @default(ZIP)
  status      ExportStatus @default(PENDING)
  filePath    String?
  fileSize    BigInt?
  requestedAt DateTime     @default(now())
  completedAt DateTime?
  expiresAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@map("project_exports")
}

model ProjectJoinRequest {
  id        String @id @default(uuid())
  projectId String
  userId    String

  message    String?
  status     JoinRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  reviewedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@map("project_join_requests")
}

model ProjectMember {
  id        String @id @default(uuid())
  projectId String
  userId    String

  role      ProjectMemberRole   @default(CONTRIBUTOR)
  status    ProjectMemberStatus @default(ACTIVE)
  joinedAt  DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments LevelAssignment[]

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model LevelAssignment {
  id        String @id @default(uuid())
  projectId String
  memberId  String
  userId    String
  levelId   String

  status      AssignmentStatus @default(ASSIGNED)
  assignedAt  DateTime         @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  dueAt       DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  level   CodingLevel   @relation(fields: [levelId], references: [id], onDelete: Cascade)

  contributions Contribution[]

  @@unique([projectId, levelId])
  @@index([projectId])
  @@index([memberId])
  @@index([userId])
  @@index([levelId])
  @@map("level_assignments")
}

model Contribution {
  id           String @id @default(uuid())
  projectId    String
  assignmentId String
  userId       String

  title       String
  description String?
  status      ContributionStatus @default(SUBMITTED)
  submittedAt DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignment LevelAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  reviews      ContributionReview[]
  fileVersions ProjectFileVersion[]

  @@index([projectId])
  @@index([assignmentId])
  @@index([userId])
  @@index([status])
  @@map("contributions")
}

model ContributionReview {
  id             String @id @default(uuid())
  contributionId String
  reviewerId     String

  decision  ReviewDecision
  feedback  String?
  createdAt DateTime       @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  reviewer     User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([contributionId])
  @@index([reviewerId])
  @@map("contribution_reviews")
}

enum ProjectStatus {
  DRAFT
  ANALYZING
  CLARIFYING
  SUGGESTING
  CONFIRMED
  ROADMAP_READY
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TechnologyCategory {
  LANGUAGE
  FRONTEND
  BACKEND
  MOBILE
  DATABASE
  FRAMEWORK
  LIBRARY
  CLOUD
  DEVOPS
  TESTING
  OTHER
}

enum LevelDifficulty {
  BEGINNER
  EASY
  MEDIUM
  HARD
  ADVANCED
}

enum LevelProgressStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

enum LevelAttemptResult {
  PENDING
  PASSED
  FAILED
}

enum FileChangeType {
  CREATED
  UPDATED
  DELETED
  RESTORED
}

enum BuildStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ExportFormat {
  ZIP
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ProjectMemberRole {
  CONTRIBUTOR
  REVIEWER
  ADMIN
}

enum ProjectMemberStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum ContributionStatus {
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}
